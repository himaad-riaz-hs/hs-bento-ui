{
  "name": "hs-bento-ui",
  "version": "0.1.0",
  "description": "HS-Bento Design System — React + Tailwind component library",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.json": "./packages/tokens/tokens.json"
  },
  "files": [
    "dist",
    "tailwind.config.ts",
    "packages/tokens"
  ],
  "scripts": {
    "dev": "storybook dev -p 6007 --initial-path /story/demos-persian--open-here",
    "dev:no-open": "storybook dev -p 6007 --no-open --initial-path /story/demos-persian--open-here",
    "dev:clean": "rm -rf node_modules/.cache/storybook && npm run dev",
    "build": "tsup && npm run build:css",
    "build:css": "tailwindcss -i ./src/tokens/index.css -o ./dist/styles.css --minify",
    "build:tokens": "node scripts/build-tokens-json.mjs",
    "build:storybook": "storybook build -o storybook-static",
    "standalone:annotated": "vite --config vite.annotated.config.ts",
    "build:annotated": "vite build --config vite.annotated.config.ts && cp dist-annotated/standalone-annotated.html dist-annotated/index.html",
    "lint": "tsc --noEmit && node scripts/check-design-tokens.mjs && node scripts/check-ui-conventions.mjs"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/react-vite": "^8.6.0",
    "@storybook/react": "^8.6.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "storybook": "^8.6.0",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.6.0"
  }
}
